{
  "id": {
    "pattern": "(?<id>(?<prefix>[A-Z]{2,4})-(?<number>\\d{3}))-.*\\.md",
    "components": {
      "prefix": { "enum": ["STK", "SYS", "SW", "ARCH", "NF", "CON"] }
    }
  },
  "fields": {
    "Title": { "required": true },
    "Type": { "required": true, "enum": ["STK", "SYS", "SW", "ARCH", "NF", "CON"] },
    "Description": { "required": true },
    "Rationale": { "required": true },
    "Verification Description": { "required": true }
  },
  "relations": {
    "section": "Relations",
    "types": {
      "Concerns": { "required": false, "targets": ["ENT"] },
      "RealizedBy": { "required": false, "targets": ["SVC", "UTL"] }
    }
  },
  "validation": { "onError": "fail" }
}
