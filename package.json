{
  "name": "ariadne-thread",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:pkg": "pnpm -r exec publint && pnpm --filter @ariadne-thread/core --filter @ariadne-thread/gen-java --filter @ariadne-thread/gen-typescript exec attw --pack . --profile esm-only",
    "dev": "tsx packages/cli/src/index.ts",
    "mint": "tsx packages/cli/src/index.ts mint",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@biomejs/biome": "^2.4.16",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.9.2",
    "@types/proper-lockfile": "^4.1.4",
    "lefthook": "^2.1.9",
    "publint": "^0.3.21",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
