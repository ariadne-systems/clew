{
  "name": "@ariadne-thread/clew",
  "version": "0.3.0",
  "description": "clew — compile-checked, id-anchored traceability for specs and code: the CLI and its engine.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "author": "Ariadne Systems GmbH",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ariadne-systems/clew.git",
    "directory": "packages/clew"
  },
  "sideEffects": false,
  "bin": {
    "clew": "./dist/cli/index.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist",
    "templates"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@ariadne-thread/trace": "workspace:*",
    "commander": "^15.0.0",
    "proper-lockfile": "^4.1.2",
    "yaml": "^2.5.0"
  }
}
